<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>lio_loop_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
      <maxInitialPeersRange>48</maxInitialPeersRange>
      <receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="lio_loop_udp_participant" is_default_profile="true">
    <rtps>
      <builtin>
        <initialPeersList><locator><udpv4><address>127.0.0.1</address></udpv4></locator></initialPeersList>
      </builtin>
      <userTransports><transport_id>lio_loop_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <data_reader profile_name="lio_loop_udp_reader" is_default_profile="true">
    <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
  </data_reader>
  <data_writer profile_name="lio_loop_udp_writer" is_default_profile="true">
    <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
  </data_writer>
</profiles>
